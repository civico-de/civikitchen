<?xml version="1.0"?>
<!--
  Psalm config for cktaint, which runs taint analysis only. A project's own
  psalm.xml or psalm.xml.dist replaces this file.

  resolveFromConfigFile="false" resolves <projectFiles> against the extension
  cktaint runs in, so the <stubs> paths into the image are absolute.
-->
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorLevel="8"
    resolveFromConfigFile="false"
    findUnusedCode="false"
    findUnusedVariablesAndParams="false"
    findUnusedBaselineEntry="false"
    allowStringToStandInForClass="true"
    usePhpDocMethodsWithoutMagicCall="true"
    ensureArrayStringOffsetsExist="false"
>
  <projectFiles>
    <directory name="." />
    <!-- allowMissingFiles: most extensions have no vendor/ or node_modules at
         all, and a missing ignore path is a hard config error otherwise. -->
    <ignoreFiles allowMissingFiles="true">
      <directory name="vendor" />
      <directory name="node_modules" />
      <!-- A sibling extension the shared CI checks out beside this one; its
           own pipeline analyses it. Same exclusion cklint makes. -->
      <directory name=".civikitchen-siblings" />
      <!-- Local dev harness (compose stacks, vendored proxies): not shipped
           extension code, and third-party PHP in there is not ours to gate. -->
      <directory name=".docker" />
    </ignoreFiles>
  </projectFiles>

  <stubs>
    <file name="/opt/civikitchen/toolbelt/psalm/stubs/CRM_Utils_Request.php" />
    <file name="/opt/civikitchen/toolbelt/psalm/stubs/Psr7.php" />
    <file name="/opt/civikitchen/toolbelt/psalm/stubs/CRM_Core_DAO.php" />
    <file name="/opt/civikitchen/toolbelt/psalm/stubs/CRM_Utils_SQL_Select.php" />
    <file name="/opt/civikitchen/toolbelt/psalm/stubs/CRM_Utils_Type.php" />
    <file name="/opt/civikitchen/toolbelt/psalm/stubs/CRM_Utils_String.php" />
    <file name="/opt/civikitchen/toolbelt/psalm/stubs/CRM_Utils_System.php" />
    <file name="/opt/civikitchen/toolbelt/psalm/stubs/CRM_Utils_File.php" />
    <file name="/opt/civikitchen/toolbelt/psalm/stubs/CRM_Utils_HttpClient.php" />
    <file name="/opt/civikitchen/toolbelt/psalm/stubs/Guzzle.php" />
  </stubs>

  <issueHandlers>
    <!-- Blocking: these classes fail cktaint (Psalm exits non-zero on "error").
         docs/extension-standards.md, "Taint analysis: `cktaint`". -->
    <TaintedSql errorLevel="error" />
    <TaintedShell errorLevel="error" />
    <TaintedInclude errorLevel="error" />
    <TaintedUnserialize errorLevel="error" />
    <TaintedSSRF errorLevel="error" />

    <!-- ADVISORY: reported ("info" prints but keeps exit 0) without failing
         the build — noisier classes where context decides severity. -->
    <TaintedFile errorLevel="info" />
    <TaintedEval errorLevel="info" />
    <TaintedLdap errorLevel="info" />
    <TaintedCallable errorLevel="info" />
    <TaintedHeader errorLevel="info" />
    <TaintedCookie errorLevel="info" />
    <TaintedSystemSecret errorLevel="info" />
    <TaintedUserSecret errorLevel="info" />
    <TaintedCustom errorLevel="info" />

    <!-- Off: CiviCRM output goes through Smarty templates Psalm never sees.
         The lint and phpstan layers cover output escaping. -->
    <TaintedHtml errorLevel="suppress" />
    <TaintedTextWithQuotes errorLevel="suppress" />

    <!-- Anything non-taint: suppressed even under a hand-run `psalm` outside
         taint mode. These are the level-1 issues an unanalysable CiviCRM
         surface produces by the hundred, and none of them is this tool's job. -->
    <UndefinedClass errorLevel="suppress" />
    <UndefinedGlobalVariable errorLevel="suppress" />
    <UndefinedDocblockClass errorLevel="suppress" />
    <UndefinedConstant errorLevel="suppress" />
    <UndefinedFunction errorLevel="suppress" />
    <UndefinedMethod errorLevel="suppress" />
    <UndefinedThisPropertyFetch errorLevel="suppress" />
    <UndefinedPropertyFetch errorLevel="suppress" />
    <UndefinedInterface errorLevel="suppress" />
    <UndefinedTrait errorLevel="suppress" />
    <InvalidDocblock errorLevel="suppress" />
    <MissingFile errorLevel="suppress" />
    <UnresolvableInclude errorLevel="suppress" />
    <DuplicateClass errorLevel="suppress" />
    <InvalidExtendClass errorLevel="suppress" />
  </issueHandlers>
</psalm>
