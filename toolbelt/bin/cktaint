#!/bin/bash
#
# cktaint — taint analysis for CiviCRM extensions: does request input reach a
# query, a shell command, a file path, an include or a redirect without being
# escaped on the way? Psalm is used ONLY as a taint engine here — never as a
# second phpstan — and it runs against CiviKitchen's CiviCRM source/sink/escape
# stubs, because Psalm cannot see CiviCRM core.
#
# The gate BLOCKS on the classes where a true positive is an outright
# vulnerability (TaintedSql/Shell/Include/Unserialize/SSRF — errorLevel="error"
# in the bundled config); the noisier classes are errorLevel="info": printed
# via --show-info, never part of the exit code. A taint engine without the
# whole framework modelled still produces false positives (a 'Positive'-typed
# retrieve() is in fact safe) and false negatives (anything crossing a hook,
# the API kernel or a Smarty template) — docs/extension-standards.md has the
# reasoning and how to deal with a finding (--baseline / @psalm-suppress).
#
# A project's own psalm.xml/.dist wins — same rule as mago.toml for cklint.
#
set -uo pipefail

# Shared plumbing: tool name, ck_die, ck_git, the extension-root check and the
# file-exclusion patterns, beside this file's real path (PATH holds a link).
# shellcheck source=../lib/ckcommon.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/ckcommon.sh"

PSALM_DIR="${ck_root}/psalm"
PSALM_BIN="${ck_root}/../vendor/bin/psalm"
DEFAULT_CONFIG="${PSALM_DIR}/psalm-taint.xml.dist"

usage() {
  cat <<'EOF'
cktaint — taint analysis for CiviCRM extensions (Psalm).

  cktaint                     analyse the whole extension (config scope)
  cktaint path ...            analyse the given files/dirs
  cktaint --config FILE       use FILE instead of the bundled taint config
  cktaint --baseline          write/refresh psalm-baseline.xml (accept today's
                              findings, so only NEW ones show up from now on)
  cktaint --no-cache          skip Psalm's cache (use after editing stubs)

Run from the extension root. A psalm.xml or psalm.xml.dist in the project is
used instead of the bundled config. Exit code is Psalm's: non-zero only for
the blocking taint classes — see docs/extension-standards.md.
EOF
}

config=""
baseline=0
paths=()
extra=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --config)    shift; config="${1:-}" ;;
    --config=*)  config="${1#--config=}" ;;
    --baseline)  baseline=1 ;;
    --no-cache)  extra+=(--no-cache) ;;
    -h|--help)   usage; exit 0 ;;
    --)          shift; break ;;
    -*)          echo "cktaint: unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)           paths+=("$1") ;;
  esac
  shift
done
while [ "$#" -gt 0 ]; do paths+=("$1"); shift; done

if [ ! -x "${PSALM_BIN}" ]; then
  echo "cktaint: psalm is not installed at ${PSALM_BIN} — is this a CiviKitchen image?" >&2
  exit 127
fi

# Config resolution: explicit --config, else the project's own psalm.xml(.dist),
# else the bundled taint-only config.
if [ -z "${config}" ]; then
  for candidate in psalm.xml psalm.xml.dist; do
    [ -f "${candidate}" ] && { config="${candidate}"; break; }
  done
fi
[ -z "${config}" ] && config="${DEFAULT_CONFIG}"

if [ ! -f "${config}" ]; then
  echo "cktaint: config not found: ${config}" >&2
  exit 2
fi

echo "== cktaint: taint analysis (SQL/shell/include/unserialize/SSRF block; INFO classes are advisory) =="
echo "cktaint: config ${config}"

# --show-info: the advisory taint classes are errorLevel="info" in the bundled
# config — reported here, but they never affect the exit code.
args=(--taint-analysis --config="${config}" --no-progress --show-info=true)
if [ "${baseline}" -eq 1 ]; then
  args+=(--set-baseline=psalm-baseline.xml)
elif [ -f psalm-baseline.xml ]; then
  # Psalm does not pick a baseline up on its own: without --use-baseline (or an
  # errorBaseline in the config) the file written by --baseline changes nothing.
  echo "cktaint: applying psalm-baseline.xml (only NEW findings are reported)"
  args+=(--use-baseline=psalm-baseline.xml)
fi
[ "${#extra[@]}" -gt 0 ] && args+=("${extra[@]}")
[ "${#paths[@]}" -gt 0 ] && args+=("${paths[@]}")

php -d memory_limit=1G "${PSALM_BIN}" "${args[@]}"
rc=$?

if [ "${rc}" -ne 0 ] && [ "${baseline}" -eq 0 ]; then
  echo >&2
  echo "cktaint: ERROR-level findings above fail the build. Fix the flow (parameterize the query, escape via CRM_Utils_Type::escape, validate the path), or — if it is a false positive — record it with 'cktaint --baseline' or a @psalm-suppress on the line, WITH a comment saying why. See docs/extension-standards.md." >&2
fi

exit "${rc}"
