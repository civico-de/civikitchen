#!/usr/bin/env bash
#
# ckcoretest — run CiviCRM *core* phpunit suites in the standalone image.
#
# The standalone image installs core from the release tarball, and
# core's .gitattributes export-ignores tests/, phpunit.xml.dist, tools/ and the
# two sql/test_data*.mysql seed files — so the dist can't initialize or run
# its own suite cleanly. This fetches exactly the missing pieces for the
# *installed* core version (sparse, blob-filtered checkout of the matching tag)
# into the core tree, then runs phpunit headless (CIVICRM_UF=UnitTests) against
# the scratch test DB.
#
# The fetched tree is cached in the container ([core]/tests/.ckcoretest-version
# marker); re-runs skip the network. A core that already ships tests/ (a
# CIVICRM_SOURCE=git build) is left untouched.
#
# Requires the CIVIKITCHEN_TEST_DB provisioning (the default): without a
# TEST_DB_DSN in ~/.cv.json this refuses to run, because headless phpunit
# would silently run against — and wipe — the dev DB.
#
# Usage (inside the app container):
#   ckcoretest tests/phpunit/api/v4/Query
#   ckcoretest --filter testDuplicateSelectAlias tests/phpunit/api/v4/Query/Api4SelectQueryTest.php
#   ckcoretest --ext search_kit [phpunit args...]   # a core extension's suite
#   ckcoretest --fetch-only            # just materialize tests/, run nothing
#   ckcoretest --e2e --ext afform/mock tests/phpunit/E2E   # browser/e2e tests, see below
#   ckcoretest --e2e tests/extensions/router-test/tests/phpunit
#
# Without --ext the test path goes last. A path inside a directory below core with its
# own phpunit.xml.dist (tests/extensions/<name>, ext/<name>) runs from that directory,
# so its config boots the system the way that suite expects.
#
# --e2e runs @group e2e tests against the dev site instead (CIVICRM_UF from the
# image, no test DB): they install extensions into it and log in as ADMIN_USER.
# Browser tests (Civi\Test\MinkBase) also need the compose browser service.
set -euo pipefail

# Shared plumbing: tool name, ck_die, ck_git, the extension-root check and the
# file-exclusion patterns, beside this file's real path (PATH holds a link).
# shellcheck source=../lib/ckcommon.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/ckcommon.sh"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  cat <<'USAGE'
ckcoretest - run CiviCRM core's PHPUnit suites against the installed core.

  ckcoretest [phpunit args] <path>            a core suite, headless
  ckcoretest --ext <name> [phpunit args]      a core extension's suite
  ckcoretest --e2e [--ext <name>] [args]      @group e2e tests against the dev site
  ckcoretest --fetch-only                     fetch tests/ for the installed version

The test path goes last. A path inside a directory with its own phpunit.xml.dist
(tests/extensions/<name>, ext/<name>) runs from that directory with its config.
Headless runs need the scratch test database (CIVIKITCHEN_TEST_DB=1).
USAGE
  exit 0
fi

: "${CK_CORE_DIR:=/var/www/html/core}"
: "${CK_CORE_REPO:=https://github.com/civicrm/civicrm-core.git}"

if [ ! -d "${CK_CORE_DIR}" ]; then
  echo "[ckcoretest] No core tree at ${CK_CORE_DIR} (set CK_CORE_DIR)" >&2
  exit 1
fi

version=$(ck_xml_field "${CK_CORE_DIR}/xml/version.xml" version_no)
if [ -z "${version}" ]; then
  echo "[ckcoretest] Could not read core version from ${CK_CORE_DIR}/xml/version.xml" >&2
  exit 1
fi

marker="${CK_CORE_DIR}/tests/.ckcoretest-version"
if [ -d "${CK_CORE_DIR}/tests/phpunit" ] && [ ! -f "${marker}" ]; then
  echo "[ckcoretest] ${CK_CORE_DIR}/tests already present (git checkout?) — not touching it"
elif [ ! -f "${marker}" ] || [ "$(cat "${marker}")" != "${version}" ]; then
  # Tarball images carry release versions only, and each has a tag; a version without
  # one (an alpha) comes from a git-source image, which ships tests/ itself.
  rc=0
  git ls-remote --quiet --exit-code "${CK_CORE_REPO}" "refs/tags/${version}" >/dev/null || rc=$?
  if [ "${rc}" = 2 ]; then
    ck_die "core ${version} has no tag in ${CK_CORE_REPO}, so there are no tests to fetch for it." \
      "Only release tarballs lack tests/; a git-source image (CIVICRM_SOURCE=git) ships them," \
      "so restore ${CK_CORE_DIR}/tests from that build."
  elif [ "${rc}" != 0 ]; then
    ck_die "git ls-remote ${CK_CORE_REPO} failed (exit ${rc})"
  fi
  echo "[ckcoretest] Fetching tests, phpunit config and seed SQL for core ${version}..."
  src=$(mktemp -d)
  trap 'rm -rf "${src}"' EXIT
  # The dist export-ignores **/tests/** — restore core's tests/ AND the
  # per-extension suites under ext/*/tests (each ext ships its phpunit.xml.dist).
  git -c advice.detachedHead=false clone --quiet --depth 1 --branch "${version}" --filter=blob:none --sparse \
      "${CK_CORE_REPO}" "${src}/core"
  git -C "${src}/core" sparse-checkout set --no-cone \
      '/phpunit.xml.dist' '/tests/' '/ext/**/tests/' \
      '/sql/test_data.mysql' '/sql/test_data_second_domain.mysql'
  rm -rf "${CK_CORE_DIR}/tests"
  mv "${src}/core/tests" "${CK_CORE_DIR}/tests"
  cp "${src}/core/phpunit.xml.dist" "${CK_CORE_DIR}/phpunit.xml.dist"
  cp "${src}/core/sql/test_data.mysql" "${src}/core/sql/test_data_second_domain.mysql" \
      "${CK_CORE_DIR}/sql/"
  # ext suites can nest (ext/afform/core/tests), so walk rather than glob
  while IFS= read -r d; do
    rel="${d#"${src}/core/"}"
    dest="${CK_CORE_DIR}/${rel}"
    [ -d "$(dirname "${dest}")" ] || continue
    rm -rf "${dest}"
    mv "${d}" "${dest}"
  done < <(find "${src}/core/ext" -type d -name tests -prune 2>/dev/null)
  echo "${version}" > "${marker}"
  chown -R www-data:www-data "${CK_CORE_DIR}/tests" "${CK_CORE_DIR}/phpunit.xml.dist" \
      "${CK_CORE_DIR}/sql/test_data.mysql" "${CK_CORE_DIR}/sql/test_data_second_domain.mysql" \
      "${CK_CORE_DIR}"/ext/*/tests 2>/dev/null || true
fi

if [ "${1:-}" = "--fetch-only" ]; then
  echo "[ckcoretest] Done — core ${version} test tree ready in ${CK_CORE_DIR}/tests"
  exit 0
fi

e2e=0
if [ "${1:-}" = "--e2e" ]; then
  e2e=1
  shift
fi

# Hard gate, not a fallback: headless boots without TEST_DB_DSN hit the dev DB.
if [ "${e2e}" = 0 ]; then
  www_home=$(getent passwd www-data | cut -d: -f6)
  if ! grep -qs TEST_DB_DSN "${www_home}/.cv.json" /root/.cv.json; then
    echo "[ckcoretest] No TEST_DB_DSN found in ~/.cv.json — refusing to run headless" >&2
    echo "[ckcoretest] tests against the dev DB. Provision with CIVIKITCHEN_TEST_DB=1." >&2
    exit 1
  fi
fi

run_dir="${CK_CORE_DIR}"
if [ "${1:-}" = "--ext" ]; then
  run_dir="${CK_CORE_DIR}/ext/${2:?--ext needs an extension name}"
  shift 2
  # Default to the ext's whole suite; core-root default would be the huge CRM suite.
  [ $# -gt 0 ] || set -- tests/phpunit
fi

cd "${run_dir}"
# A suite with its own phpunit.xml.dist below core (tests/extensions/<name>) runs from
# there: core's config boots only to settings level, so the test listener skips the boot.
# The last word is the test path unless it is an option or the value of one; phpunit's
# own help names the options that take a value (--filter <pattern>, -c|--configuration <file>).
path=""
if [ "${run_dir}" = "${CK_CORE_DIR}" ] && [ $# -gt 0 ]; then
  last="${!#}"
  prev=""
  [ $# -gt 1 ] && prev="${*:$#-1:1}"
  value_opts=" $(phpunit --help | sed -nE 's/^ +(-[a-zA-Z])?\|?(--[a-z0-9-]+)? <[^>]+>.*/\1 \2/p' | tr '\n' ' ') "
  if [[ "${last}" != -* ]] && { [ -z "${prev}" ] || [[ "${value_opts}" != *" ${prev} "* ]]; }; then
    path="${last}"
    [ -e "${path}" ] || ck_die "no test file or directory '${path}' in ${CK_CORE_DIR} (the test path goes last)"
  fi
fi
if [ -n "${path}" ]; then
  if [ -d "${path}" ]; then
    full=$(cd "${path}" && pwd -P)
    dir="${full}"
  else
    dir=$(cd "$(dirname "${path}")" && pwd -P)
    full="${dir}/$(basename "${path}")"
  fi
  core_real=$(pwd -P)
  while [ "${dir}" != "${core_real}" ] && [ "${dir}" != / ]; do
    if [ -f "${dir}/phpunit.xml.dist" ]; then
      rel="${full#"${dir}"}"
      rel="${rel#/}"
      set -- "${@:1:$#-1}" "${rel:-.}"
      cd "${dir}"
      break
    fi
    dir=$(dirname "${dir}")
  done
fi
if [ "${e2e}" = 1 ]; then
  # As the web user: files the tests make the site write (afform's ang/ cache) must stay writable for it.
  if [ "$(id -u)" = 0 ]; then
    exec runuser -u www-data -- "$(command -v phpunit)" --group e2e "$@"
  fi
  exec phpunit --group e2e "$@"
fi
# Startup-only ini, as core's suite expects it: no sendmail in the image (mail() would fail
# where buildkit's CIVICRM_MAIL_LOG succeeds); ExternalBatch needs $_ENV (variables_order E).
exec env CIVICRM_UF=UnitTests php -d sendmail_path=/bin/true -d variables_order=EGPCS "$(command -v phpunit)" "$@"
