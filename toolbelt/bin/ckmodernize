#!/bin/bash
#
# ckmodernize — one-command modernization for a CiviCRM extension, via the
# civikitchen-bundled tools. The extension carries NOTHING: civikitchen
# provides everything, so you can modernize/upgrade any extension *through* the
# image. It orchestrates two layers, each with the right tool:
#
#   1. STRUCTURE — civix (the official scaffolding migrator):
#        civix upgrade          old hook boilerplate -> mixins, info.xml format,
#                               regenerated glue (version-incremental)
#        civix convert-entity   legacy XML entity declarations -> entityType.php
#   2. CODE — rector: off-the-shelf PHP-version + quality sets PLUS CiviKitchen's
#        CiviCRM footgun rules (the deprecations cklint flags).
#
# api3 -> apiv4 is NOT rewritten by default (APIv4 is a deliberate breaking
# change) — the opt-in --api / --api=array flags migrate a safe subset;
# everything else cklint flags for a human.
#
# Pairs with cklint:   cklint flags  ->  ckmodernize fixes what's mechanical.
# A project's own rector.php wins for the code step when present.
#
set -uo pipefail

# Shared plumbing: tool name, ck_die, ck_git, the extension-root check and the
# file-exclusion patterns, beside this file's real path (PATH holds a link).
# shellcheck source=../lib/ckcommon.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/ckcommon.sh"

RECTOR_DIR="${ck_root}/rector"
RECTOR_BIN="${ck_root}/../vendor/bin/rector"
DEFAULT_CONFIG="${RECTOR_DIR}/rector.php"

usage() {
  cat <<'EOF'
ckmodernize — modernize a CiviCRM extension (structure via civix + code via rector).

  ckmodernize                preview the code changes (dry-run); list the civix steps
  ckmodernize --fix          apply: civix structure upgrade + rector code rewrite
  ckmodernize --php 8.2      target PHP version for rector's upgrade sets
                             (default: composer.json's require.php floor, else 8.1)
  ckmodernize --no-civix     code only (skip the civix structure step)
  ckmodernize --no-rector    structure only (skip the rector code step)
  ckmodernize --api          ALSO migrate api3 -> api4 OO (safe get() subset; preview!)
  ckmodernize --api=array    array API style: migrate api3 -> api4 array, keep arrays

By default, existing api4 array-form calls are restyled to the OO builder (safe,
same semantics). --api adds the riskier api3 -> api4 migration (review it!).
  ckmodernize path ...       limit the rector step to the given files/dirs
  ckmodernize --all          run rector over the whole tree

Run from the extension root. civix steps run only for a civix extension (an
info.xml with a <civix> block) and only on --fix (civix has no preview mode).
EOF
}

fix=0
all=0
do_civix=1
do_rector=1
paths=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --fix|-f)    fix=1 ;;
    --all)       all=1 ;;
    --no-civix)  do_civix=0 ;;
    --no-rector) do_rector=0 ;;
    --api)       export CK_API_MIGRATE=oop ;;
    --api=*)     export CK_API_MIGRATE="${1#--api=}" ;;
    --php)       shift; export CK_PHP_VERSION="${1:-}" ;;
    --php=*)     export CK_PHP_VERSION="${1#--php=}" ;;
    -h|--help)   usage; exit 0 ;;
    --)          shift; break ;;
    -*)          echo "ckmodernize: unknown option: $1" >&2; usage >&2; exit 2 ;;
    *)           paths+=("$1") ;;
  esac
  shift
done
while [ "$#" -gt 0 ]; do paths+=("$1"); shift; done

# -------------------------------------------------------------------------
# 1. Structure — civix (writes; civix has no dry-run, so we only run it on --fix
#    and otherwise just announce the plan).
if [ "${do_civix}" -eq 1 ] && [ -f info.xml ] \
    && "$ck_root/bin/ck" internal xml-has-child info.xml civix; then
  if [ "${fix}" -eq 1 ]; then
    echo "== civix: modernizing scaffolding =="
    if ! civix upgrade -n; then
      echo "ckmodernize: civix upgrade failed; fix that before the code step" >&2
      exit 1
    fi
    # convert-entity boots CiviCRM, and only EFv1 schema XML gives it work.
    if compgen -G 'xml/schema/CRM/*/*.xml' >/dev/null || compgen -G 'xml/schema/CRM/*/*/*.xml' >/dev/null; then
      if ! civix convert-entity -n; then
        echo "ckmodernize: civix convert-entity failed; fix that before the code step" >&2
        exit 1
      fi
    fi
  else
    echo "== civix (structure): on --fix this runs 'civix upgrade' + 'civix convert-entity' (civix has no preview) =="
  fi
fi

# -------------------------------------------------------------------------
# 2. Code — rector (dry-run preview by default).
if [ "${do_rector}" -eq 1 ]; then
  echo "== rector: modernizing code =="

  if [ "${all}" -eq 1 ]; then
    paths=(".")
  elif [ "${#paths[@]}" -eq 0 ]; then
    for d in Civi CRM api; do [ -d "$d" ] && paths+=("$d"); done
    while IFS= read -r f; do [ -n "$f" ] && paths+=("$f"); done \
      < <(find . -maxdepth 1 -name '*.php' -type f 2>/dev/null)
    [ "${#paths[@]}" -eq 0 ] && paths=(".")
  fi

  # rector's type inference needs core on the autoloader. The default path
  # only fits the standalone layout; every other flavour answers through cv.
  if [ -z "${CIVICRM_CORE_DIR:-}" ]; then
    CIVICRM_CORE_DIR="$(cv path -d '[civicrm.root]' 2>/dev/null || true)"
    export CIVICRM_CORE_DIR
  fi
  if [ ! -f "${CIVICRM_CORE_DIR}/CRM/Core/ClassLoader.php" ]; then
    echo "ckmodernize: no CiviCRM core found (cv path -d '[civicrm.root]' gave '${CIVICRM_CORE_DIR}'); set CIVICRM_CORE_DIR" >&2
    exit 1
  fi

  # A project's own rector.php wins; otherwise the bundled CiviKitchen config.
  config=("--config" "${DEFAULT_CONFIG}")
  [ -f rector.php ] && config=()

  rargs=(process "${paths[@]}" "${config[@]}" --no-progress-bar)
  [ "${fix}" -eq 0 ] && rargs+=(--dry-run)
  php -d memory_limit=1G "${RECTOR_BIN}" "${rargs[@]}"
  rc=$?
  if [ -n "${CK_API_MIGRATE:-}" ]; then
    echo >&2
    echo "ckmodernize --api: assisted only the safe literal get() calls (checkPermissions + limit guardrails kept). Results are migrated only where read solely as ['values'] / ['count'] in the same function; their rows follow APIv4's fields, types and default filters (is_deleted/is_test/is_template), so counts can change. Other actions, operators, chaining, dynamic params and any other result use stay api3 — review manually; cklint flags every remaining civicrm_api3 call." >&2
  fi
  exit "${rc}"
fi
