#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * ckconform — repo-conformance check for CiviCRM extensions against the
 * civikitchen template. Complements cklint (style) and phpstan (types): this
 * checks the repo structure, the gaps every extension audit turned up.
 *
 * Run from the extension root. Beside the toolbelt's shared PHP library its only
 * dependency is the YAML parser of the scenario-schema package, which the image ships.
 */

use CiviKitchen\Ckconform\Autoloader;
use CiviKitchen\Ckconform\Context;
use CiviKitchen\Ckconform\DistPaths;
use CiviKitchen\Ckconform\Policy;
use CiviKitchen\Ckconform\Registry;
use CiviKitchen\Ckconform\Reporter;

require_once __DIR__ . '/../src/Autoloader.php';
Autoloader::register();

$root = getcwd();
if (in_array($argv[1] ?? '', ['-h', '--help'], true)) {
    echo <<<'TXT'
ckconform - repository conformance for a CiviCRM extension. Run from the extension root.

  ckconform [--format=human|json|github|sarif]   run every check
  ckconform --policy-env                         civikitchen.yaml as shell variables
  ckconform --policy <key>                       every value of one policy key
  ckconform --dist-paths                         what a release archive leaves out and stages

Suppress a finding with `// ckconform-ignore <check> -- <reason>`.

TXT;
    exit(0);
}
$format = 'human';
for ($i = 1; $i < count($argv); $i++) {
    if (str_starts_with($argv[$i], '--format=')) {
        $format = substr($argv[$i], strlen('--format='));
        array_splice($argv, $i, 1);
        $i--;
    } elseif ($argv[$i] === '--format') {
        $format = $argv[$i + 1] ?? '';
        array_splice($argv, $i, 2);
        $i--;
    }
}
if (!in_array($format, ['human', 'json', 'github', 'sarif'], true)) {
    fwrite(STDERR, "ckconform: --format must be human, json, github, or sarif.\n");
    exit(2);
}

/**
 * Read-out modes for `civikitchen.yaml`, and the only way ck* shell tools get at
 * it — so that Policy stays the one parser of this format instead of the
 * seventh.
 *
 *   eval "$(ckconform --policy-env)"   # CK_POLICY_MIN_COVERAGE='70', …
 *   ckconform --policy <key>           # every value of one key, one per line
 *   ckconform --dist-paths             # `dir <name>` / `file <name>`, then `stage <path>`, one per line
 *
 * Both read the repo file over the CK_DEFAULT_CONFIG layer (Policy::effective).
 * --policy-env gives the scalar view with the ` -- <reason>` stripped, which is
 * what a shell caller comparing a number wants. --policy keeps the value
 * verbatim, for the repeatable keys and for the callers whose job is to check
 * that the reason is there (cklifecycle). --dist-paths is the same arrangement
 * one level up: DistPaths owns what a release archive leaves out and stages, ckrelease
 * reads it from here rather than keeping a second copy in bash.
 *
 * Before the info.xml gate and before a single check is constructed, on
 * purpose: this is a config read, its callers have already asserted they are at
 * the extension root, and a read-out that cost a full conformance run is a
 * read-out those callers would go back to writing in sed.
 */
$policyRaw = static function () use ($root): string {
    $base = $root === false ? '.' : $root;
    if (is_file($base . '/' . Policy::LEGACY_FILE)) {
        throw new RuntimeException(Policy::LEGACY_FILE . ' is no longer supported; migrate its policy to ' . Policy::CONFIG_FILE);
    }
    $file = $base . '/' . Policy::CONFIG_FILE;
    if (!is_file($file)) {
        return '';
    }
    // A file that is there but cannot be read is no empty policy.
    $raw = is_readable($file) ? file_get_contents($file) : false;
    if ($raw === false) {
        throw new RuntimeException('cannot read ' . Policy::CONFIG_FILE);
    }

    return $raw;
};
try {
switch ($argv[1] ?? '') {
    case '--policy-env':
        echo Policy::toShell($policyRaw());
        exit(0);
    case '--policy':
        $key = $argv[2] ?? '';
        if ($key === '') {
            fwrite(STDERR, "ckconform: --policy needs a key, e.g. --policy min_coverage\n");
            exit(2);
        }
        if (!isset(Policy::KEYS[$key])) {
            fwrite(STDERR, "ckconform: --policy {$key}: not a policy key\n");
            exit(2);
        }
        foreach (Policy::effective($policyRaw())[$key] ?? [] as $value) {
            echo $value, "\n";
        }
        exit(0);
    case '--dist-paths':
        $distContext = new Context($root === false ? '.' : $root);
        $problems = DistPaths::problems($distContext);
        if ($problems !== []) {
            // Exit rather than print a list the caller would build an archive
            // from: an exclude that resolves nowhere excludes nothing.
            foreach ($problems as $problem) {
                fwrite(STDERR, "ckconform: {$problem}\n");
            }
            exit(2);
        }
        $distPaths = DistPaths::excluded($distContext);
        foreach ($distPaths['dirs'] as $dir) {
            echo 'dir ', $dir, "\n";
        }
        foreach ($distPaths['files'] as $file) {
            echo 'file ', $file, "\n";
        }
        foreach (DistPaths::staged($distContext) as $path) {
            echo 'stage ', $path, "\n";
        }
        exit(0);
}
} catch (Throwable $e) {
    fwrite(STDERR, "ckconform: {$e->getMessage()}\n");
    exit(2);
}

if ($root === false || !is_file($root . '/info.xml')) {
    fwrite(STDERR, "ckconform: no info.xml here — run from the extension root.\n");
    exit(2);
}

$coreDir = getenv('CIVICRM_CORE_DIR') ?: '/var/www/html/core';
$context = new Context($root, is_dir($coreDir . '/Civi/Api4') ? $coreDir : null);
$reporter = new Reporter();
$reporter->suppressWith($context);
if ($context->exists(Policy::LEGACY_FILE)) {
    fwrite(STDERR, 'ckconform: ' . Policy::LEGACY_FILE . ' is no longer supported; migrate its policy to ' . Policy::CONFIG_FILE . "\n");
    exit(2);
}
try {
    $context->policy();
} catch (Throwable $e) {
    fwrite(STDERR, "ckconform: {$e->getMessage()}\n");
    exit(2);
}

// The repo-wide escape level: ignore_checks=<name>,<name> -- <reason> in
// civikitchen.yaml policy.ignore_checks skips whole checks. The reason is not optional, and a name no
// check carries is a dead ignore — both fail rather than silently narrowing.
$ignored = [];
$ignoreRaw = $context->policyValue('ignore_checks');
if ($ignoreRaw !== null) {
    $reporter->setRule('policy');
    $parts = array_map('trim', explode('--', $ignoreRaw, 2));
    if (count($parts) < 2 || $parts[1] === '') {
        $reporter->fail('civikitchen.yaml: policy.ignore_checks needs a reason — <name>,... -- <reason>');
    } else {
        $ignored = array_filter(array_map('trim', explode(',', $parts[0])));
        $known = array_map(static fn ($c) => $c->name(), Registry::all());
        foreach (array_diff($ignored, $known) as $unknown) {
            $reporter->fail("civikitchen.yaml: policy.ignore_checks names an unknown check '{$unknown}'");
        }
    }
}
// Hand the skip list on: an inline ignore for a check that never ran is not an
// unused ignore, and only this loop knows which checks were skipped.
$context->skipChecks(array_values($ignored));

foreach (Registry::all() as $check) {
    if (in_array($check->name(), $ignored, true)) {
        continue;
    }
    $reporter->setRule($check->name());
    $check->run($context, $reporter);
}

echo match ($format) {
    'json' => $reporter->renderJson(),
    'github' => $reporter->renderGithub(),
    'sarif' => $reporter->renderSarif(),
    default => $reporter->render(),
};

exit($reporter->failures() === 0 ? 0 : 1);
