# Pins with more than one reader. KEY=value with no spaces, so Make `include`s
# it and bash sources it. The CK_ prefix lets a same-named --build-arg win.

# Images (install-dev-tools.sh, standalone git stage) and the Makefile.
# Re-derive the hash on a bump: curl -LsS <url> | sha256sum
CK_COMPOSER_VERSION=2.10.3
CK_COMPOSER_SHA256=7a2d379d5b8ffdaa028580ef26494c36d2feef4b178d3dd1473a4dbc5e17c8d6

# install-dev-tools.sh and the Makefile's tool test suites.
# Re-derive the hash on a bump: curl -LsS <url> | sha256sum
CK_PHPUNIT_VERSION=9.6.35
CK_PHPUNIT_SHA256=f39d634a5e5bcafd71565b33328ae4fb173703296c12ac94a24550cb8291e964

# install-dev-tools.sh, the Makefile and the SDK pin in composer.json. mago
# publishes no checksums: curl -LsS <url> | sha256sum
CK_MAGO_VERSION=1.55.0
CK_MAGO_SHA256_linux_x86_64=2e51ecdd31a2486cda8ea509940867514c6373c94612e7d47594c75034ae7a14
CK_MAGO_SHA256_linux_aarch64=861f036335be116813a1d4a663cf6bd72c4385814f8edeb37bcc94797ed3b426

# Standalone minors built besides the current stable (resolve-civicrm-stable.sh);
# the extra_standalone_minors dispatch input overrides it for one run.
CK_STANDALONE_EXTRA_MINORS=6.16,6.17,6.19

# Read by the Makefile (this site and the extension-docs suite) and by
# extension-docs.yml (the extension handbooks).
CK_ZENSICAL_VERSION=0.0.70
