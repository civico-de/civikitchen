# Pins with more than one reader. KEY=value with no spaces, so Make `include`s
# it and bash sources it natively.
#
# It sits beside install-dev-tools.sh, which sources it from
# /opt/civikitchen/toolbelt in the images.
#
# A pin with ONE reader stays where it is used — the rest of
# install-dev-tools.sh, CK_TRIVY_* in build-dev-images.yml, actionlint and
# zizmor in the Makefile.
#
# CK_ prefix: keeps these clear of the same-named build ARGs, so --build-arg
# still wins over the default it feeds.

# Read by install-dev-tools.sh and the standalone image's git source stage
# (the images' composer) and by the Makefile (the lockfile gate and the tool
# suites run on the same release). Re-derive the hash on a bump:
# curl -LsS <url> | sha256sum
CK_COMPOSER_VERSION=2.10.3
CK_COMPOSER_SHA256=7a2d379d5b8ffdaa028580ef26494c36d2feef4b178d3dd1473a4dbc5e17c8d6

# Read by install-dev-tools.sh (the phar in the image) and by the Makefile
# (the tool test suites run on the same one). Re-derive the hash on a bump:
# curl -LsS <url> | sha256sum
CK_PHPUNIT_VERSION=9.6.35
CK_PHPUNIT_SHA256=f39d634a5e5bcafd71565b33328ae4fb173703296c12ac94a24550cb8291e964

# Read by install-dev-tools.sh (the image binary) and by the Makefile (the
# mago extension's fixture suite). mago publishes no checksum file, so each
# hash is derived at pin time: curl -LsS <url> | sha256sum. The extension
# SDK in toolbelt/mago-ext/composer.json pins the same version.
CK_MAGO_VERSION=1.55.0
CK_MAGO_SHA256_linux_x86_64=2e51ecdd31a2486cda8ea509940867514c6373c94612e7d47594c75034ae7a14
CK_MAGO_SHA256_linux_aarch64=861f036335be116813a1d4a663cf6bd72c4385814f8edeb37bcc94797ed3b426

# Read by resolve-civicrm-stable.sh: supported standalone minors in addition to the
# current upstream stable, comma-separated (each resolved to its newest patch
# release, built and promoted as :standalone-X.Y). A workflow_dispatch
# extra_standalone_minors input overrides this list for one run.
CK_STANDALONE_EXTRA_MINORS=6.16,6.17,6.18,6.19
