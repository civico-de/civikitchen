# Follow toolbelt/lib/ckcommon.sh, which the ck* tools source, so its
# variables do not read as SC2154 "referenced but not assigned".
external-sources=true
source-path=SCRIPTDIR

# SC1091: container-absolute sourced paths do not exist at lint time.
# SC2016: single-quoted $vars in embedded PHP and sed programs are theirs.
disable=SC1091,SC2016
