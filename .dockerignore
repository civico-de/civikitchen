# The build context is the repo root. Exclude only what no COPY needs and would
# be wrong to copy (host-built artifacts, VCS metadata).

# The largest thing in the context, and no build step reads it.
.git

# The image installs this tree with `npm ci`; a host-built one carries the
# host's platform.
toolbelt/oxlint/node_modules
toolbelt/oxfmt/node_modules

# The composer root's vendor/ from a local test run is the host's, not the
# image's; composer.lock is the opposite: it MUST reach the image.
/vendor
toolbelt/mago-ext/tests/.work
toolbelt/ckconform/.phpunit.result.cache
toolbelt/phpstan/.phpunit.result.cache
toolbelt/rector/.phpunit.result.cache
node_modules
