#!/bin/bash
#
# ckup — start an extension's dev stack on host ports that are free.
#
# The template compose reads its host ports from .docker/.env
# (CK_HTTP_PORT, CK_MAILDEV_PORT, CK_SMTP_PORT, CK_PMA_PORT) and derives
# CIVIKITCHEN_SITE_URL from the HTTP one. This writes a missing variable with
# the first free port at or above its default, keeps what is already there
# (a stack keeps its ports across restarts), then runs `docker compose up -d`
# with any further arguments passed through. Before that it installs vendor/
# in every mounted extension that ships a composer.json without one.
#
# The stack runs the image CI runs: :standalone-<minor> of policy.civicrm in
# civikitchen.yaml, unless CIVIKITCHEN_IMAGE is set in the environment or
# .docker/.env; with neither, the compose file's default.
#
# Usage, from anywhere inside the extension repo:  ckup [compose up args]
set -euo pipefail

tool="ckup"
die() { echo "$tool: $*" >&2; exit 2; }

: "${CK_PORT_CHECK:=ck_port_free}"
: "${CK_POLICY_READ:=ck_policy_civicrm}"
checkout="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

dir="$PWD"
while [[ ! -f "$dir/.docker/docker-compose.yml" ]]; do
  [[ "$dir" != "/" ]] || die "no .docker/docker-compose.yml above $PWD"
  dir="$(dirname "$dir")"
done
env_file="$dir/.docker/.env"

# A port is taken when something on the host accepts a connection on it.
ck_port_free() {
  ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

# Variable, default; appends the first free port to .env when the variable is
# not there yet and marks it as taken for the rest of this run.
taken=""
assign() {
  local name="$1" port="$2" existing
  existing="$( [[ -f "$env_file" ]] && sed -n "s/^${name}=//p" "$env_file" | tail -1 || true)"
  if [[ -n "$existing" ]]; then
    # Kept as it is, and off limits for the variables still to be assigned —
    # a stopped stack's port probes as free.
    taken="${taken},${existing}"
    return 0
  fi
  while [[ ",${taken}," == *",${port},"* ]] || ! "$CK_PORT_CHECK" "$port"; do
    port=$((port + 1))
    [[ "$port" -le 65535 ]] || die "no free port for $name"
  done
  taken="${taken},${port}"
  printf '%s=%s\n' "$name" "$port" >> "$env_file"
  echo "$tool: $name=$port"
}

assign CK_HTTP_PORT 8080
assign CK_MAILDEV_PORT 1080
assign CK_SMTP_PORT 1025
assign CK_PMA_PORT 8081

# policy.civicrm through ckconform, the one civikitchen.yaml parser, from the
# image (the host needs only bash and Docker); runs in the extension directory.
ck_policy_civicrm() {
  docker run --rm -v "$PWD:/ext:ro" -w /ext --entrypoint ckconform \
    ghcr.io/civico-de/civikitchen:v1 --policy civicrm
}

pinned="$( [[ -f "$env_file" ]] && sed -n 's/^CIVIKITCHEN_IMAGE=//p' "$env_file" | tail -1 || true)"
if [[ -n "${CIVIKITCHEN_IMAGE:-}" ]]; then
  echo "$tool: image $CIVIKITCHEN_IMAGE (CIVIKITCHEN_IMAGE)"
elif [[ -n "$pinned" ]]; then
  echo "$tool: image $pinned (CIVIKITCHEN_IMAGE in .docker/.env)"
else
  minor=""
  if [[ -f "$dir/civikitchen.yaml" ]]; then
    minor="$(cd "$dir" && "$CK_POLICY_READ")" || die "cannot read policy.civicrm from $dir/civikitchen.yaml"
  fi
  # The mapping and validation the shared CI workflows use.
  image="$("$checkout/.github/scripts/stack-image.sh" "$minor" "" "")" || die "no stack image for policy.civicrm"
  if [[ -n "$image" ]]; then
    export CIVIKITCHEN_IMAGE="$image"
    echo "$tool: image $image (policy.civicrm $minor)"
  else
    echo "$tool: image from the compose file's default (no policy.civicrm)"
  fi
fi

cd "$dir/.docker"
# The seed snapshot store the compose file mounts. Created here, before Docker
# would create it as root, and open to the image's web user, who writes it.
mkdir -p snapshots
chmod 0777 snapshots
# As the calling user, with the image's PHP and composer: vendor/ lands in the
# host checkout and must belong to its owner, not to the image's web user.
docker compose run --rm --no-deps -T -u "$(id -u):$(id -g)" -e HOME=/tmp \
  --entrypoint sh app -c 'exec ck internal composer-install /var/www/html/ext/*/' \
  || die "composer install failed in a mounted extension (output above)"
docker compose up -d "$@"
http_port="$(sed -n 's/^CK_HTTP_PORT=//p' "$env_file" | tail -1)"
echo "$tool: CiviCRM at http://localhost:${http_port}"
