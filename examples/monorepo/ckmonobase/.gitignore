# Dependencies are installed, not committed — but their LOCKFILES are, so a
# build can be reproduced. ckconform fails a repo that ignores a lockfile.
/vendor/
node_modules/

# PHP tooling caches
.phpunit.result.cache
.phpunit.cache/
.phpstan-cache/

# Docker secrets
.docker/.env
# Seed snapshots the dev stack stores (.docker/docker-compose.yml)
.docker/snapshots/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# TypeScript's incremental build cache (named after the tsconfig it belongs
# to, so a bare '.tsbuildinfo' pattern misses it)
*.tsbuildinfo

# Playwright's session file, report and traces (playwright.config.ts)
.auth/
/playwright-report/
/test-results/
