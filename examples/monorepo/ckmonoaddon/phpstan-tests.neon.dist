# Second phpstan pass over the test suite, at the same level and without a
# baseline; the ck.test.* rules see only analysed files.
includes:
	- phpstan.neon.dist

parameters:
	level: 10
	# `!` overrides the included list instead of appending to it.
	paths!:
		- tests/phpunit
	# Scan the extension's classes, so runtime-loaded APIv4 façades stay known.
	scanDirectories:
		- Civi
	# PHPUnit comes from core's dev dependencies; a packaged install may need:
	#	scanDirectories:
	#		- /var/www/html/core/vendor/phpunit/phpunit/src
