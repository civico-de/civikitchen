{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/civico-de/civikitchen/main/packages/civikitchen-scenario-schema/scenario.schema.json",
  "title": "CiviKitchen configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "anyOf": [{"required": ["policy"]}, {"required": ["scenario"]}],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "enum": [1]},
    "policy": {"$ref": "#/$defs/policy"},
    "scenario": {"$ref": "#/$defs/scenario"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "pattern": "^(?!.* -- )[^\\r\\n]*\\S[^\\r\\n]*$"},
    "literalStringList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"}},
    "stringList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
    "reason": {"type": "string", "minLength": 1, "pattern": "^(?!.* -- )[^\\r\\n]*\\S[^\\r\\n]*$"},
    "pathReason": {
      "type": "object", "additionalProperties": false, "required": ["path", "reason"],
      "properties": {"path": {"$ref": "#/$defs/nonEmptyString"}, "reason": {"$ref": "#/$defs/reason"}}
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "ignore_checks": {"type": "object", "additionalProperties": false, "required": ["checks", "reason"], "properties": {"checks": {"$ref": "#/$defs/stringList"}, "reason": {"$ref": "#/$defs/reason"}}},
        "coverage": {"type": "object", "additionalProperties": false, "properties": {"minimum": {"type": "integer", "minimum": 0, "maximum": 100}}},
        "tests": {"type": "object", "additionalProperties": false, "required": ["mode", "reason"], "properties": {"mode": {"enum": ["optional"]}, "reason": {"$ref": "#/$defs/reason"}}},
        "license": {"$ref": "#/$defs/nonEmptyString"},
        "copyright": {"$ref": "#/$defs/nonEmptyString"},
        "vendor": {"oneOf": [{"$ref": "#/$defs/nonEmptyString"}, {"type": "object", "additionalProperties": false, "required": ["mode", "reason"], "properties": {"mode": {"enum": ["committed"]}, "reason": {"$ref": "#/$defs/reason"}}}]},
        "hook_style": {"enum": ["listener"]},
        "known_hooks": {"$ref": "#/$defs/stringList"},
        "known_api4_entities": {"type": "object", "additionalProperties": false, "required": ["entities", "reason"], "properties": {"entities": {"$ref": "#/$defs/stringList"}, "reason": {"$ref": "#/$defs/reason"}}},
        "bundles": {"type": "object", "additionalProperties": false, "required": ["mode", "reason"], "properties": {"mode": {"enum": ["committed"]}, "reason": {"$ref": "#/$defs/reason"}}},
        "deploy_hygiene": {"type": "object", "additionalProperties": false, "required": ["paths", "reason"], "properties": {"paths": {"$ref": "#/$defs/stringList"}, "reason": {"$ref": "#/$defs/reason"}}},
        "vendored_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathReason"}},
        "smarty_skip_templates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["template", "reason"], "properties": {"template": {"$ref": "#/$defs/nonEmptyString"}, "reason": {"$ref": "#/$defs/reason"}}}},
        "npm_license": {"$ref": "#/$defs/nonEmptyString"},
        "release": {"type": "object", "additionalProperties": false, "required": ["mode", "reason"], "properties": {"mode": {"enum": ["none"]}, "reason": {"$ref": "#/$defs/reason"}}},
        "untagged_versions": {"description": "info.xml <version> values the repo moved past without a v<version> tag, each with the reason it stays untagged (release-tags skips them; a listed version that is tagged or that info.xml never carried is reported as stale).", "type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["version", "reason"], "properties": {"version": {"description": "The version as written in info.xml, without the v — release-tags prefixes the v itself when it looks for the tag, so a v-prefixed entry matches nothing and warns as stale forever.", "type": "string", "pattern": "^[0-9][A-Za-z0-9._-]*$"}, "reason": {"$ref": "#/$defs/reason"}}}},
        "max_unreleased_days": {"type": "integer", "minimum": 0},
        "mutation": {"type": "object", "additionalProperties": false, "properties": {"minimum_msi": {"type": "integer", "minimum": 0, "maximum": 100}, "minimum_covered_msi": {"type": "integer", "minimum": 0, "maximum": 100}, "paths": {"$ref": "#/$defs/stringList"}}},
        "dist": {"type": "object", "additionalProperties": false, "properties": {"exclude": {"$ref": "#/$defs/literalStringList"}, "include": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pathReason"}}, "build": {"description": "Output the release archive carries although git does not track it: the build runs before the archive is built, and exactly these paths join the archived tree.", "type": "object", "additionalProperties": false, "required": ["tool", "outputs"], "properties": {"tool": {"description": "bun: `bun install --frozen-lockfile`, then `bun run build`, on the Bun that package.json pins as packageManager (bun@x.y.z), with a committed bun.lock.", "enum": ["bun"]}, "outputs": {"description": "Repository-relative files or directories the build writes. Each must exist after the build and must not be tracked by git.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"}}}}}},
        "javascript": {"type": "object", "additionalProperties": false, "properties": {"type_check": {"description": "ckeslint also reports TypeScript compiler diagnostics for the repo's JavaScript (allowJs + checkJs), through the repo's tsconfig.json or, without one, a CiviKitchen tsconfig over a copy of the tracked source.", "type": "boolean"}}},
        "lifecycle": {"type": "object", "additionalProperties": false, "properties": {"log_ignore": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["pattern", "reason"], "properties": {"pattern": {"$ref": "#/$defs/nonEmptyString"}, "reason": {"$ref": "#/$defs/reason"}}}}}},
        "template_custom": {"type": "object", "additionalProperties": false, "required": ["paths", "reason"], "properties": {"paths": {"$ref": "#/$defs/stringList"}, "reason": {"$ref": "#/$defs/reason"}}},
        "renovate_preset": {"$ref": "#/$defs/nonEmptyString"},
        "civicrm": {"description": "The CiviCRM minor the extension targets, quoted (\"6.17\"; unquoted YAML reads 6.10 as 6.1). extension-ci.yml and extension-release.yml then run on the :standalone-<minor> image instead of the contract image; passing their image input as well is an error. GitLab CI picks its image before the repository is read and does not use it.", "type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "database": {"description": "The database image of the extension's stacks, for a repository whose production server runs another MariaDB than the template default (mariadb:11.4). ckinit writes it into the managed CI compose file (and into the dev compose file when it seeds one), and extension-release.yml's smoke test runs on it; scenario.database.image, where set, must name the same image. Only the MariaDB versions the image build verifies against the current CiviCRM release are accepted. GitLab CI runs .gitlab-ci.yml's CK_DB_IMAGE instead: ckinit writes it into a new caller and stops while an existing one names another image. In a monorepo it belongs in each extension's civikitchen.yaml.", "enum": ["mariadb:10.11", "mariadb:11.4", "mariadb:12.2"]},
        "ci": {"description": "Where the repository runs CI. Absent: GitHub Actions (the managed .github/workflows callers and renovate.json). gitlab: a managed .gitlab-ci.yml that includes civikitchen's ci/gitlab/extension-ci.yml, for a single-extension repository; GitLab has no shared release pipeline, so such a repo declares release: none.", "enum": ["gitlab"]},
        "extension_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["key", "version", "sha256", "reason"], "oneOf": [{"required": ["url"]}, {"required": ["release"]}], "properties": {"key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "version": {"$ref": "#/$defs/nonEmptyString"}, "url": {"type": "string", "format": "uri", "pattern": "^https://[^/?\\x23@]+(?:/[^?\\x23]*)?$"}, "release": {"type": "object", "additionalProperties": false, "required": ["repository", "tag", "asset"], "properties": {"repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"}, "tag": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"}, "asset": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"}}}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "reason": {"$ref": "#/$defs/reason"}}}}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["name", "image", "database", "extension"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "image": {"$ref": "#/$defs/nonEmptyString"},
        "database": {"type": "object", "additionalProperties": false, "required": ["image"], "properties": {"image": {"$ref": "#/$defs/nonEmptyString"}}},
        "extension": {"type": "object", "additionalProperties": false, "required": ["key", "path"], "properties": {"key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"}, "path": {"$ref": "#/$defs/nonEmptyString"}, "writable": {"type": "boolean"}}},
        "trust_external_extension": {"type": "boolean"},
        "site_url": {"type": "string", "format": "uri", "pattern": "^http://"},
        "http_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "locales": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}_[A-Z]{2}$"}},
        "default_locale": {"type": "string", "pattern": "^[a-z]{2,3}_[A-Z]{2}$"},
        "profiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}},
        "profile_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "trust_external_profiles": {"type": "boolean"},
        "credentials_output": {"enum": ["file", "log", "both", "none"]},
        "allow_secret_logging": {"type": "boolean"},
        "checks": {"type": "array", "uniqueItems": true, "items": {"enum": ["conform", "lint", "format", "compatibility", "dependencies", "javascript", "test", "coverage", "lifecycle", "smarty", "taint", "mutate"]}}
      }
    }
  }
}
