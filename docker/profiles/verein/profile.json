      "role": "civikitchen_api_fundraiser",
      "permissions": [
        "access CiviCRM",
        "access AJAX API",
        "view all contacts",
        "edit all contacts",
        "add contacts",
        "access CiviContribute",
        "edit contributions",
        "delete in CiviContribute",
        "manage campaign",
        "administer CiviCampaign",
        "access CiviReport",
        "view all activities",
        "delete activities"
      ]
    },
    {
      "username": "eventmanager",
      "role": "civikitchen_api_eventmanager",
