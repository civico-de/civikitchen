        "delete in CiviCase",
        "administer CiviCase",
        "access CiviReport",
        "view all activities",
        "delete activities"
      ]
    },
    {
      "username": "bankimporter",
      "role": "civikitchen_api_bankimporter",
      "permissions": [
        "access CiviCRM",
        "access AJAX API",
        "view all contacts",
        "edit all contacts",
        "access CiviContribute",
        "edit contributions",
        "administer CiviCRM",
        "view all activities",
        "delete activities"
      ]
    }
