        "view all contacts",
        "access Contact Dashboard",
        "access CiviContribute",
        "access CiviEvent",
        "access CiviMember",
        "access CiviReport",
        "view all activities",
        "view event info",
        "view event participants",
        "access all cases and activities"
      ]
    },
    {
