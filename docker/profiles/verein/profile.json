      "enable": true
    },
    {
      "name": "de.systopia.contract",
      "repo": "https://github.com/systopia/de.systopia.contract.git",
      "version": "82250a27835e6af4b32d38af0ebd8faca48753cd",
      "enable": true
    },
    {
      "name": "de.systopia.twingle",
      "repo": "https://github.com/systopia/de.systopia.twingle.git",
