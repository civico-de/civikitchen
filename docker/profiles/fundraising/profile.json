{
  "description": "Spendenwerk Musterstadt e.V.: campaigns, donors with a year of giving, recurring donors, pledges, a donation page with a test payment processor, core only",
  "dependencies": [
    {
      "name": "org.civicrm.search_kit",
      "enable": true
    },
    {
      "name": "org.civicrm.afform",
      "enable": true
    }
  ],
  "config": {
    "settings": {
      "defaultCurrency": "EUR"
    },
    "components": [
      "CiviContribute",
      "CiviCampaign",
      "CiviPledge"
    ],
    "anonymous_permissions": [
      "make online contributions"
    ]
  },
  "snapshot": {
    "calendar": "year",
    "sizes": [
      "demo"
    ],
    "after_restore": [
      "scripts/20-search.php"
    ]
  },
  "scripts": [
    "scripts/10-fundraising.php",
    "scripts/20-search.php",
    "scripts/30-donation-page.php"
  ]
}
