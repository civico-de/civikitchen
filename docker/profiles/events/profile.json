{
  "description": "Past and upcoming events with participants in varied statuses, core only",
  "dependencies": [
    {
      "name": "org.civicrm.search_kit",
      "enable": true
    },
    {
      "name": "org.civicrm.afform",
      "enable": true
    }
  ],
  "config": {
    "settings": {
      "defaultCurrency": "EUR"
    },
    "components": [
      "CiviEvent"
    ],
    "anonymous_permissions": [
      "profile create",
      "register for events"
    ]
  },
  "snapshot": {
    "calendar": "none",
    "sizes": [
      "demo"
    ],
    "after_restore": [
      "scripts/20-search.php"
    ]
  },
  "scripts": [
    "scripts/10-events.php",
    "scripts/20-search.php"
  ]
}
